# URL du serveur FastAPI. Le serveur autorise http://localhost:5173 (CORS) par defaut.
VITE_API_URL=http://localhost:8000

# Nombre de postes du centre, pour le KPI "Postes en ligne N / max".
# Absent ou vide : 1.
VITE_MAX_STATIONS=4

# Hote du serveur video MediaMTX (decision 0019), sans http:// ni port : les ports WebRTC (8889)
# et HLS (8888) sont fixes. Absent ou vide : la page Live affiche des images fixes.
VITE_MEDIA_HOST=localhost

# URL completes de MediaMTX, pour un front en https derriere un proxy (decision 0020). Une page
# https ne peut pas lire http://<hote>:8889. Chaque URL remplace l'hote ci-dessus pour son
# protocole ; absente, on garde http://VITE_MEDIA_HOST:<port>.
# VITE_MEDIA_WEBRTC_URL=https://video.exemple.fr
# VITE_MEDIA_HLS_URL=https://hls.exemple.fr
