# Copie ce fichier en .env (dans agent/) puis adapte les valeurs.
# Serveur sur la meme machine :
SIMRACE_SERVER_URL=http://localhost:8000
# Serveur sur une autre machine du reseau (le serveur doit ecouter avec --host 0.0.0.0) :
# SIMRACE_SERVER_URL=http://192.168.1.50:8000

# Nom du poste (par defaut : nom de la machine)
# SIMRACE_STATION_ID=sim-1

# Jeu lu en direct : auto (detecte le jeu lance, par defaut), acc (Assetto Corsa Competizione)
# ou acevo (Assetto Corsa EVO). --source le remplace pour probe, run et record.
# SIMRACE_SOURCE=acevo
